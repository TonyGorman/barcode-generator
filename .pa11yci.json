{
  "defaults": {
    "standard": "WCAG2AA",
    "timeout": 60000,
    "wait": 1500,
    "chromeLaunchConfig": {
      "args": ["--no-sandbox", "--disable-dev-shm-usage"]
    }
  },
  "urls": [
    {
      "url": "http://127.0.0.1:4173/#specific-default",
      "actions": []
    },
    {
      "url": "http://127.0.0.1:4173/#specific-error",
      "actions": ["click element #panel-specific button[aria-label='Generate Labels']"]
    },
    {
      "url": "http://127.0.0.1:4173/#specific-generated",
      "actions": [
        "set field #panel-specific input[id$='specific-input'] to 01L01A",
        "click element #panel-specific button[aria-label='Generate Labels']"
      ]
    },
    {
      "url": "http://127.0.0.1:4173/#aisle-default",
      "actions": ["click element #tab-aisle"]
    },
    {
      "url": "http://127.0.0.1:4173/#aisle-generated",
      "actions": [
        "click element #tab-aisle",
        "set field #panel-aisle input[id$='aisle-start'] to 1",
        "set field #panel-aisle input[id$='aisle-end'] to 1",
        "set field #panel-aisle input[id$='-L-start'] to 1",
        "set field #panel-aisle input[id$='-L-end'] to 1",
        "set field #panel-aisle select[id$='shelf-end'] to A",
        "click element #panel-aisle button[aria-label='Generate Labels']"
      ]
    },
    {
      "url": "http://127.0.0.1:4173/#back-default",
      "actions": ["click element #tab-bak"]
    },
    {
      "url": "http://127.0.0.1:4173/#back-generated",
      "actions": [
        "click element #tab-bak",
        "set field #panel-bak input[id$='bay-start'] to 1",
        "set field #panel-bak input[id$='bay-end'] to 1",
        "set field #panel-bak select[id$='shelf-end'] to A",
        "click element #panel-bak button[aria-label='Generate Labels']"
      ]
    },
    {
      "url": "http://127.0.0.1:4173/#landing-default",
      "actions": []
    }
  ]
}
