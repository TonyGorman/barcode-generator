{
  "name": "label-generator",
  "version": "1.0.4",
  "private": true,
  "engines": {
    "node": "^24"
  },
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:bundle",
    "build:bundle": "vite build",
    "lint": "eslint src",
    "lint:complexity": "eslint src --rule 'complexity: [\"error\", 10]'",
    "lint:naming": "node scripts/lint-naming-conventions.mjs",
    "prune": "knip",
    "validate:ci": "npm run styles:types:check && npm run styles:audit && npm run prettier:check && npm run lint && npm run lint:naming && npm run lint:complexity && npm run test:run && npm run build:bundle",
    "validate:release": "npm run validate:ci && npm run audit:prod && npm run test:a11y && npm run test:e2e",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "preview": "vite preview",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "styles:types": "node scripts/generate-css-module-types.mjs",
    "styles:types:check": "node scripts/generate-css-module-types.mjs --check",
    "styles:audit": "node scripts/audit-css-modules.mjs",
    "test": "vitest",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint src --fix",
    "test:run": "npm run typecheck && npm run test:unit",
    "test:a11y": "vitest run src/components/accessibility.test.tsx",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/visual-baselines.spec.ts",
    "test:visual:update": "playwright test tests/e2e/visual-baselines.spec.ts --update-snapshots=all",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "prettier": "prettier --write \"./src/**/*.{ts,tsx,css}\"",
    "prettier:check": "prettier --check \"./src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "jsdom": "^30.0.0",
    "knip": "^6.32.2",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.5",
    "vitest-axe": "^0.1.0"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
